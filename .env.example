# Copy to .env.local for local development. Never commit real credentials.
# Use mysql for the application database; pglite keeps the repository-only demo mode.
DATABASE_PROVIDER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=minoriya_starter
MYSQL_USER=minoriya_app
MYSQL_PASSWORD=
SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public application origin. Register /auth/callback in Supabase Auth redirect URLs.
APP_ORIGIN=http://localhost:3000
# Development only: npm run dev applies pending migrations when enabled.
AUTO_MIGRATE=false
DEV_SUPABASE_PROJECT_REF=
# Server-only integration secrets (at least 32 random characters each).
CRON_SECRET=
INTEGRATION_INGEST_TOKEN=
ERP_ORDER_API_URL=
ERP_API_TOKEN=
POS_PRICE_API_URL=
POS_API_TOKEN=
# Optional synthetic data setup. Never enable in Production.
ALLOW_DEMO_DATA_SETUP=false
DEMO_SEED_AUTH_USERS=false
DEMO_INITIAL_PASSWORD=
DEMO_EMAIL_DOMAIN=example.invalid
# Demo only: omit the code field and connect /station to DEMO-001.
DEMO_STATION_AUTO_CONNECT=false
DEVICE_DEMO_001_TOKEN=
