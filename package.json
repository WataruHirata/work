{
  "name": "minoriya-sales-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:browser:campaigns": "node --env-file=.env.local --env-file-if-exists=.env.browser-check.local scripts/verify-admin-campaigns.mjs",
    "db:demo": "node --env-file=.env.local scripts/setup-demo.mjs",
    "db:demo:devices": "node --env-file=.env.local scripts/setup-demo-devices.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:check": "node --env-file-if-exists=.env.local scripts/migrate.mjs --dry-run",
    "db:mysql:migrate": "node --env-file-if-exists=.env.local scripts/mysql-migrate.mjs",
    "db:mysql:demo": "node --env-file-if-exists=.env.local scripts/setup-mysql-demo.mjs",
    "db:mysql:demo:check": "node --env-file-if-exists=.env.local scripts/verify-mysql-demo.mjs",
    "integrations:run": "node --env-file-if-exists=.env.local scripts/run-integrations.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.59.0",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright-core": "^1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
